# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Supabase Cloud PostgreSQL Connection (Using Supavisor Pooler on port 6543):
# Format: postgresql+psycopg2://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Required when APP_ENV=production (32+ characters):
# SESSION_SECRET=
COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
SESSION_HOURS=12
ATTENDANCE_THRESHOLD_PERCENT=60

# Google Meet API integration:
# Google Cloud Console -> APIs & Services -> Credentials -> Create API Key or OAuth 2.0 Client
GOOGLE_MEET_API_KEY=AIzaSy...your_google_meet_api_key_here

