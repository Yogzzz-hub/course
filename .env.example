# Public build configuration. NEVER put secrets in VITE_ variables.
VITE_SITE_URL=
VITE_ACADEMY_NAME=Aintrix Academy
VITE_BRAND_APPROVED=false
VITE_LEGAL_APPROVED=false
VITE_CONTACT_EMAIL=aintrixacademy2026@gmail.com
VITE_CONTACT_PHONE=
VITE_CALENDLY_URL=
# Optional booking/CMS API base. Same-origin /api/booking is the default.
VITE_BOOKING_API_URL=
# Authenticated Student Panel. Public configuration only; no API keys.
VITE_STUDENT_API_URL=/api/student
VITE_STUDENT_SIGN_IN_URL=/auth/sign-in?returnTo=%2Fstudent-panel
# Admin API must authenticate every request and enforce current two-factor verification.
VITE_ADMIN_API_URL=/api/admin
VITE_ADMIN_SIGN_IN_URL=/auth/admin/sign-in?returnTo=%2Fadmin-panel
# Comma-separated HTTPS gateway origins; only these can receive checkout redirects.
VITE_PAYMENT_GATEWAY_ORIGINS=
# Server secrets belong in Cloudflare Pages settings or ignored .dev.vars:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=bf137c001@smtp-brevo.com
# SMTP_PASS=xsmtpsib-...
# SMTP_FROM=Aintrix Academy <aintrixacademy2026@gmail.com>
# RESEND_API_KEY=
# ENQUIRY_FROM=Aintrix Academy <admissions@aintrix.com>
# ENQUIRY_TO=aintrixacademy2026@gmail.com
# RECEIVER_EMAIL=aintrixacademy2026@gmail.com
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# ALLOWED_ORIGIN=https://your-domain
# RATE_LIMIT_SALT=<random secret>
# LEGAL_APPROVED=true
# Bind an ENQUIRY_LIMITS KV namespace (24-hour abuse/idempotency records).

# Optional local API server; Vite proxies /api/* only when configured.
VITE_DEV_API_PROXY_TARGET=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Separate learning API (server-only values; never prefix secrets with VITE_).
DATABASE_URL=postgresql://academy:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/academy
APP_ORIGIN=http://127.0.0.1:5173
PORT=8787
VITE_LEARNING_PROXY_TARGET=http://127.0.0.1:8787
# Provision administrators using server/manage.ts; do not commit credentials.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_ROLE=owner
# Optional remote execution. No local fallback exists.
LEARNING_JUDGING_ENABLED=false
# JUDGE0_URL=https://your-isolated-judge-host
# JUDGE0_AUTH_TOKEN=
# JUDGE0_PYTHON_LANGUAGE_ID=<reviewed pinned Python runtime ID>
JUDGE0_SANDBOX_REVIEWED=false
