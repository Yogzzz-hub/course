# Public build configuration. NEVER put secrets in VITE_ variables.
VITE_SITE_URL=
VITE_ACADEMY_NAME=Academy
VITE_BRAND_APPROVED=false
VITE_LEGAL_APPROVED=false
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CALENDLY_URL=
# Server secrets belong in Cloudflare Pages settings or ignored .dev.vars:
# RESEND_API_KEY=
# ENQUIRY_FROM=Academy <verified-sender@your-domain>
# ENQUIRY_TO=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# ALLOWED_ORIGIN=https://your-domain
# RATE_LIMIT_SALT=<random secret>
# LEGAL_APPROVED=true
# Bind an ENQUIRY_LIMITS KV namespace (24-hour abuse/idempotency records).
