# Public build configuration. NEVER put secrets in VITE_ variables.
VITE_SITE_URL=
VITE_ACADEMY_NAME=Shadow Sphere Technical Academy
VITE_BRAND_APPROVED=false
VITE_LEGAL_APPROVED=false
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CALENDLY_URL=
# Optional booking/CMS API base. Same-origin /api/booking is the default.
VITE_BOOKING_API_URL=
# Authenticated Student Panel. Public configuration only; no API keys.
VITE_STUDENT_API_URL=/api/student
VITE_STUDENT_SIGN_IN_URL=/auth/sign-in?returnTo=%2Fstudent-panel
# Admin API must authenticate every request and enforce current two-factor verification.
VITE_ADMIN_API_URL=/api/admin
VITE_ADMIN_SIGN_IN_URL=/auth/admin/sign-in?returnTo=%2Fadmin-panel
# Comma-separated HTTPS gateway origins; only these can receive checkout redirects.
VITE_PAYMENT_GATEWAY_ORIGINS=
# Server secrets belong in Cloudflare Pages settings or ignored .dev.vars:
# RESEND_API_KEY=
# ENQUIRY_FROM=Academy <verified-sender@your-domain>
# ENQUIRY_TO=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# ALLOWED_ORIGIN=https://your-domain
# RATE_LIMIT_SALT=<random secret>
# LEGAL_APPROVED=true
# Bind an ENQUIRY_LIMITS KV namespace (24-hour abuse/idempotency records).

# Optional local API server; Vite proxies /api/* only when configured.
VITE_DEV_API_PROXY_TARGET=
